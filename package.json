{
  "name": "price-finder-v3",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "netlify": "netlify dev",
    "desktop:dev": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "cheerio": "^1.1.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "netlify-cli": "^23.9.2",
    "electron-builder": "^26.0.12"
  },
  "main": "desktop/main.mjs",
  "build": {
    "appId": "fr.pricefinder.app",
    "productName": "PRICE FINDER",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "desktop/**/*", "netlify/functions/**/*", "package.json"],
    "win": { "target": ["nsis"], "artifactName": "PRICE-FINDER-Setup-${version}.exe" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
