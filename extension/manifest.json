{
  "manifest_version": 3,
  "name": "PRICE FINDER – Comparateur PC",
  "version": "1.1.0",
  "description": "Compare automatiquement le produit de la page avec PRICE FINDER dans une petite fenêtre.",
  "permissions": ["contextMenus", "activeTab", "storage"],
  "host_permissions": [
    "https://price-finder.netlify.app/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "action": {"default_title": "PRICE FINDER"},
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]
}
